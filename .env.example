# Copiar para /opt/dio/dio-lista-prod/.env e preencher.
# O mesmo LABNETCOL_SECRET do portal (labnetcol) é obrigatório para SSO.

LISTA_PORT=8088
LISTA_DATA_DIR=/opt/dio/dio-lista-prod/data
LISTA_DIST=/opt/dio/dio-lista-prod/dist
LISTA_DEV_LOGIN=0
LISTA_JWT_SECRET=trocar-por-segredo-longo
LISTA_ADMIN_IDS=1

# Público (DNS + nginx)
# https://lista.labnetcol.pt

# Igual ao LabNetCol em produção
LABNETCOL_SECRET=igual-ao-portal
LABNETCOL_FRONTEND_URL=https://labnetcol.pt
LABNETCOL_API_URL=https://labnetcol.pt

# Opcional: seed catálogo na 1.ª subida
# LISTA_SEED=1
# LISTA_SEED_FILE=/opt/dio/dio-lista-prod/seed/catalogo_base.json
