# lista.labnetcol.pt → lista_serv em 127.0.0.1:8088
# Instalar: copiar para sites-available, symlink sites-enabled, certbot, reload.

server {
    listen 80;
    listen [::]:80;
    server_name lista.labnetcol.pt;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name lista.labnetcol.pt;

    # certbot --nginx -d lista.labnetcol.pt  (preenche estes paths)
    # ssl_certificate     /etc/letsencrypt/live/lista.labnetcol.pt/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/lista.labnetcol.pt/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
